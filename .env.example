# Copiar a .env y completar. Nunca commitear .env real.

# Ruta del archivo SQLite. Relativa a la raíz del proyecto.
ARCHIVUM_DB_PATH=data/archivum.db

# Vacío = sin autenticación (uso local). Poné un valor random largo acá en
# cuanto la app quede expuesta en un dominio público (ej. PythonAnywhere) —
# sin esto, cualquiera con la URL puede leer y escribir en la biblioteca.
ARCHIVUM_AUTH_TOKEN=

# Credenciales de AO3 para el importador (Tarea 2).
AO3_USERNAME=
AO3_PASSWORD=

# User-Agent identificable para las peticiones a AO3 (Tarea 2).
AO3_CONTACT_EMAIL=tu-email@ejemplo.com

# Segundos mínimos entre peticiones a AO3. No bajar de 4. En corridas largas
# (import bookmarks de una biblioteca grande) 6 da más margen antes de que
# AO3 empiece a devolver 429/503 sostenido.
AO3_MIN_DELAY_SECONDS=6

# Límite de peticiones por sesión de importación (Tarea 2).
AO3_MAX_REQUESTS_PER_SESSION=500

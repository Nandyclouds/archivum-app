# Copiar a .env y completar. Nunca commitear .env real.

# Ruta del archivo SQLite. Relativa a la raíz del proyecto.
ARCHIVUM_DB_PATH=data/archivum.db

# Vacío = sin autenticación (uso local). Poné un valor random largo acá en
# cuanto la app quede expuesta en un dominio público (ej. PythonAnywhere) —
# sin esto, cualquiera con la URL puede leer y escribir en la biblioteca.
ARCHIVUM_AUTH_TOKEN=

# Solo hace falta si vas a usar el sync por GitHub Actions (import por link/
# EPUB/bookmarks nuevos desde un host sin salida a AO3, como PythonAnywhere).
# ARCHIVUM_SYNC_SECRET: otro valor random largo, DISTINTO del de arriba — va
#   acá y también como secret del repo en GitHub (mismo valor en los dos
#   lados). GITHUB_PAT: token personal de GitHub con permiso "Actions:
#   write" sobre el repo. GITHUB_REPO: "usuario/nombre-del-repo".
ARCHIVUM_SYNC_SECRET=
GITHUB_PAT=
GITHUB_REPO=

# Credenciales de AO3 para el importador (Tarea 2).
AO3_USERNAME=
AO3_PASSWORD=

# Alternativa a AO3_USERNAME/AO3_PASSWORD para cuando AO3 bloquea el login
# automatizado (ej. desafío "Shields are up!" en /users/login): si está
# puesta, se usa esta en vez de loguearse con usuario/contraseña. Se
# consigue logueándote en AO3 con tu navegador de siempre y copiando el
# valor de la cookie "_otwarchive_session" (DevTools > Application/
# Almacenamiento > Cookies > archiveofourown.org). Vence cada tanto — cuando
# deje de andar, hay que volver a copiarla.
AO3_SESSION_COOKIE=

# User-Agent identificable para las peticiones a AO3 (Tarea 2).
AO3_CONTACT_EMAIL=tu-email@ejemplo.com

# Segundos mínimos entre peticiones a AO3. No bajar de 4. En corridas largas
# (import bookmarks de una biblioteca grande) 6 da más margen antes de que
# AO3 empiece a devolver 429/503 sostenido.
AO3_MIN_DELAY_SECONDS=6

# Límite de peticiones por sesión de importación (Tarea 2).
AO3_MAX_REQUESTS_PER_SESSION=500
